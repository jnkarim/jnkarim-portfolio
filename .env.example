# Server-side API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# From address must belong to a domain verified in your Resend account.
# Example: Portfolio <hello@your-verified-domain.com>
CONTACT_FROM_EMAIL=Portfolio <hello@your-verified-domain.com>

# Inbox for contact form submissions (defaults to this address if omitted).
CONTACT_TO_EMAIL=julkernkarim@gmail.com

# Optional: GitHub token to increase API limits for deployed-repo discovery.
# GITHUB_TOKEN=github_pat_your_read_only_token_here
